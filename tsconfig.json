{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "importHelpers": true,  // Enables tslib for helpers like spread
    "lib": ["es2017", "DOM"] 
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}